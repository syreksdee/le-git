generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Variant {
  id          Int       @id @default(autoincrement())
  name        String
  subtitle    String?
  description String    @db.Text
  imageUrl    String
  isSoldOut   Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  packages    Package[]
}

model Package {
  id        Int      @id @default(autoincrement())
  variantId Int
  sizeLabel String   // e.g., "Regular Size (8 cm)" or "Mini Bites (5 cm)"
  name      String   // e.g., "Reguler Package (3 pcs)"
  pieceCount Int
  price     Int      // Stored in IDR (e.g., 35000)
  variant   Variant  @relation(fields: [variantId], references: [id], onDelete: Cascade)
}

model Admin {
  id        Int      @id @default(autoincrement())
  username  String   @unique
  password  String
  createdAt DateTime @default(now())
}

model StoreSettings {
  id            Int    @id @default(1)
  pickupAddress String @db.Text
}